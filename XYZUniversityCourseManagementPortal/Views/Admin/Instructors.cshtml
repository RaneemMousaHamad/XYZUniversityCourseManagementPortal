@model IEnumerable<XYZUniversityCourseManagementPortal.Models.Instructor>

@{
    ViewData["Title"] = "Instructors";
    ViewBag.Message = "All instructors";
}

<h2>@ViewData["Title"]</h2>
<p>@ViewBag.Message</p>

<p><a asp-action="CreateInstructor">Create New Instructor</a></p>

<table class="table">
    <tr>
        <th>ID</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Department</th>
        <th>Actions</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FirstName</td>
            <td>@item.LastName</td>
            <td>@(item.Department?.Name ?? "N/A")</td>
            <td>
                <a asp-action="InstructorDetails" asp-route-id="@item.Id">Details</a> |
                <a asp-action="EditInstructor" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="DeleteInstructor" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>
