@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="display-5 mb-3">Admin Dashboard</h1>
            <p class="lead text-muted">Manage users, departments, courses, and instructors</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <h5 class="card-title">
                            <i class="bi bi-people"></i> User Management
                        </h5>
                        <p class="card-text text-muted">View and manage registered users, assign roles, and delete users.</p>
                    </div>
                    <a asp-action="Users" class="btn btn-primary mt-auto">Manage Users</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <h5 class="card-title">
                            <i class="bi bi-building"></i> Departments
                        </h5>
                        <p class="card-text text-muted">Create, update, view, and delete departments.</p>
                    </div>
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-primary mt-auto">Manage Departments</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <h5 class="card-title">
                            <i class="bi bi-book"></i> Courses
                        </h5>
                        <p class="card-text text-muted">Create, update, view, and delete courses.</p>
                    </div>
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-primary mt-auto">Manage Courses</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <h5 class="card-title">
                            <i class="bi bi-person-badge"></i> Instructors
                        </h5>
                        <p class="card-text text-muted">View, update, and delete instructors. Assign instructors to courses.</p>
                    </div>
                    <a asp-action="Instructors" class="btn btn-primary mt-auto">Manage Instructors</a>
                </div>
            </div>
        </div>
    </div>
</div>

