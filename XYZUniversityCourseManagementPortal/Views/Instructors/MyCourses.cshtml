@model IEnumerable<XYZUniversityCourseManagementPortal.Models.InstructorCourse>

@{
    ViewData["Title"] = "My Courses";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>My Courses</h2>
            <p class="text-muted">View and manage your assigned courses. Enroll students and add grades.</p>
            @if (ViewBag.InstructorName != null)
            {
                <p class="text-muted">Welcome, <strong>@ViewBag.InstructorName</strong></p>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Course ID</th>
                                <th>Course Name</th>
                                <th>Department</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var courseId = item.InstructorCourse_course?.Id ?? 0;
                                <tr>
                                    <td>@courseId</td>
                                    <td><strong>@item.InstructorCourse_course?.Name</strong></td>
                                    <td>@(item.InstructorCourse_course?.Department?.Name ?? "N/A")</td>
                                    <td>
                                        @if (courseId > 0)
                                        {
                                            <a asp-action="CourseStudents" 
                                               asp-route-courseId="@courseId" 
                                               class="btn btn-sm btn-primary">
                                                Manage Students
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Invalid Course</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <p class="text-muted"><strong>Total Courses:</strong> @Model.Count()</p>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <p class="mb-0">No courses assigned to you yet. Please contact the administrator to assign courses.</p>
                </div>
            }
        </div>
    </div>
</div>
