@{
    ViewData["Title"] = "API Course Catalog";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0" style="color: var(--uni-plum);">Courses (Loaded from Web API)</h2>
        <button class="btn btn-outline-primary" onclick="fetchCourses()">Refresh</button>
    </div>

    <div id="apiLoading" class="text-center my-3">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2">Loading courses from API...</p>
    </div>

    <div id="apiError" class="text-danger mb-3"></div>

    <div class="table-responsive">
        <table id="apiCoursesTable" class="table table-striped table-hover align-middle" style="display:none;">
            <thead class="table-dark">
                <tr>
                    <th>CourseId</th>
                    <th>Title</th>
                </tr>
            </thead>
            <tbody id="apiCoursesBody"></tbody>
        </table>
    </div>

</div>

@section Scripts {
    <script>
        const apiUrl = '/api/Courses';

        document.addEventListener('DOMContentLoaded', fetchCourses);

        async function fetchCourses() {
            const loader = document.getElementById('apiLoading');
            const errorDiv = document.getElementById('apiError');
            const table = document.getElementById('apiCoursesTable');
            const body = document.getElementById('apiCoursesBody');

            errorDiv.textContent = '';
            body.innerHTML = '';
            loader.style.display = 'block';
            table.style.display = 'none';

            try {
                const response = await fetch(apiUrl);
                if (!response.ok) throw new Error('HTTP ' + response.status);

                const data = await response.json();

                loader.style.display = 'none';
                table.style.display = 'table';

                if (!data || data.length === 0) {
                    body.innerHTML = `
                        <tr>
                            <td colspan="2" class="text-center text-muted">No courses found.</td>
                        </tr>`;
                    return;
                }

                data.forEach(c => {
                    // API returns { Id, Name } => JS sees { id, name }
                    body.innerHTML += `
                        <tr>
                            <td class="text-muted">${c.id}</td>
                            <td>${c.name}</td>
                        </tr>`;
                });

            } catch (err) {
                console.error(err);
                loader.style.display = 'none';
                table.style.display = 'none';
                errorDiv.textContent = 'Could not load courses from the API';
            }
        }
    </script>
}
