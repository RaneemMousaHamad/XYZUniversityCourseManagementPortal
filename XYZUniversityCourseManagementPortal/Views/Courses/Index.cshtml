@model IEnumerable<XYZUniversityCourseManagementPortal.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Courses</h2>
            <p class="text-muted">Manage all courses in the system</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Create New Course</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Course Name</th>
                            <th>Department</th>
                            <th>Instructors</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var instructorCount = item.InstructorCourses?.Count() ?? 0;
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.Name</strong></td>
                                <td>@(item.Department?.Name ?? "N/A")</td>
                                <td>
                                    @if (instructorCount > 0)
                                    {
                                        <span class="badge bg-info">@instructorCount instructor(s)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No instructors</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Details</a>
                                        <a asp-action="AssignInstructors" asp-route-id="@item.Id" class="btn btn-outline-success">Instructors</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
